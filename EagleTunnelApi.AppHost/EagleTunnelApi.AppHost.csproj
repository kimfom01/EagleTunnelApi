<Project Sdk="Aspire.AppHost.Sdk/13.0.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>70689f9f-b820-4b96-954f-25b3d6ae85ef</UserSecretsId>
        <!-- Plain 'dotnet run' orchestration: dependencies come from NuGet, not the
             Aspire CLI bundle. Per https://aka.ms/aspire/diagnostics/aspire010 the
             correction for staying on NuGet orchestration is to opt out explicitly
             and suppress ASPIRE010, which is what both lines below do. -->
        <AspireUseCliBundle>false</AspireUseCliBundle>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\EagleTunnelApi\EagleTunnelApi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
        <!-- Aspire.Hosting 13.6.1 resolves MessagePack 2.5.302 transitively, which is
             flagged by NU1902 (GHSA-qhrr-8q5h-9q3h). Pin the patched 2.5.x line so the
             build stays warning-free without changing the Aspire API surface. -->
        <PackageReference Include="MessagePack" Version="2.5.307" />
    </ItemGroup>

</Project>
