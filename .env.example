Tribute__ApiKey=<Tribute API Key used to verify webhook signatures>
Panel__BaseUri=<Panel API Base Uri (e.g. https://panel.example.com/admin)>
Panel__ApiKey=<Panel API Token from Panel Settings > Authentication > API Token>
Telegram__BotToken=<Telegram Bot Token from @BotFather>
Telegram__SupportUrl=<Support Telegram link (e.g. https://t.me/support)>
Telegram__DefaultInboundIds=<Comma-separated inbound ids (e.g. 1,2)>
Telegram__AdminIds=<Comma-separated Telegram user ids allowed to manage the panel (optional)>
Telegram__WebhookUrl=<Public webhook base URL, REQUIRED in production (e.g. https://bot.example.com)>
Telegram__WebhookSecretToken=<Secret token verified on each Telegram webhook request>
