# Uncomment for deployed environments so the Telegram webhook is registered.
# ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Postgres=<PostgreSQL connection string, e.g. Host=postgres;Database=eagletunnelapi;Username=postgres;Password=...>
Tribute__ApiKey=<Tribute API Key used to verify webhook signatures>
Panel__BaseUri=<Panel API Base Uri (e.g. https://panel.example.com/admin)>
Panel__ApiKey=<Panel API Token from Panel Settings > Authentication > API Token>
Telegram__BotToken=<Telegram Bot Token from @BotFather>
Telegram__SupportUrl=<Support Telegram link (e.g. https://t.me/support)>
Telegram__TributeSubscriptionUrl=<Subscription/checkout link shown in menus and reminders>
Telegram__DefaultInboundIds=<Comma-separated panel inbound ids (e.g. 2,6); seed/fallback for the effective DB-backed default set>
Telegram__AdminIds=<Comma-separated Telegram user ids allowed to manage the panel and receive sync alerts (optional)>
Telegram__WebhookUrl=<Public webhook base URL, REQUIRED in production (e.g. https://bot.example.com)>
Telegram__WebhookPath=<Telegram webhook route (e.g. /webhooks/telegram)>
Telegram__WebhookSecretToken=<Secret token verified on each Telegram webhook request>
Telegram__BotUsername=<Bot username without '@' (e.g. EagleTunnelBot), used for referral links>
Telegram__ReferralBonusDays=<Free days granted to a referrer on referee's first payment (default 30, 0 disables)>
Telegram__ReminderHourUtc=<Hour of day (UTC, 0-23) for expiry reminders (default 9)>
Telegram__TrialDurationHours=<Free trial hours for newly registered accounts (default 3, 0 disables)>
# Optional panel sync settings. Defaults match appsettings.json.
PanelSync__IntervalMinutes=<Minutes between cursor sync runs, 1-1440 (default 10)>
PanelSync__FullReconcileHours=<Hours between full scans for deletions, 1-720 (default 24)>
PanelSync__FailureAlertThreshold=<Consecutive sync failures before admin alert, 2-100 (default 3)>
PanelSync__ConflictNotificationBatchSize=<Maximum open conflicts notified per pass, 1-200 (default 50)>
PanelSync__CommentBackfillOnStartup=<Run legacy comment backfill once after the first successful sync (default true)>
