<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>eaa49cf4-d3c1-45b1-a6a2-98eee84857b3</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <!-- Explicit override for the vulnerable transitive Microsoft.OpenApi 2.0.0 (GHSA-v5pm-xwqc-g5wc).
             Must stay 2.x (>= 2.12.0): Microsoft.AspNetCore.OpenApi 10.0.12's source generator
             emits code that does not compile against 3.x. -->
        <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
        <PackageReference Include="NSwag.AspNetCore" Version="14.7.1"/>
        <PackageReference Include="Telegram.Bot" Version="22.10.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\EagleTunnelApi.ServiceDefaults\EagleTunnelApi.ServiceDefaults.csproj"/>
    </ItemGroup>

</Project>
